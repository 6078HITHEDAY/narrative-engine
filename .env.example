# 选择后端: deepseek / openai / ollama
NARRATIVE_BACKEND=deepseek

# DeepSeek API 密钥 (或 OpenAI / Ollama 留空)
NARRATIVE_API_KEY=sk-your-key-here

# 自定义 API 地址 (Ollama: http://localhost:11434/v1)
NARRATIVE_API_BASE=

# 模型名 (留空使用后端默认)
NARRATIVE_MODEL=

# 生成参数
NARRATIVE_TEMPERATURE=0.8
NARRATIVE_MAX_TOKENS=256
NARRATIVE_TIMEOUT=10.0

# 缓存目录
NARRATIVE_CACHE_DIR=.cache/narrative_engine
